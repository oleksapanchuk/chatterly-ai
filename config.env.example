# OpenAI API Key (обов'язково для Layer 2)
OPENAI_API_KEY=your_openai_api_key_here

# Deepgram API Key (опціонально для Layer 1 аудіо транскрипції)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Налаштування моделей
DEFAULT_MODEL=gpt-4o
MAX_RETRIES=3
TEMPERATURE=0.1

# Налаштування сервера
HOST=localhost
PORT=8000
DEBUG=True

# Пороги модерації (за замовчуванням)
DEFAULT_HARM_THRESHOLD=70.0
DEFAULT_CONFIDENCE_THRESHOLD=0.6

# Обмеження розміру файлів (в байтах)
MAX_TEXT_LENGTH=100000
MAX_IMAGE_SIZE=20971520  # 20MB
MAX_AUDIO_SIZE=52428800  # 50MB 